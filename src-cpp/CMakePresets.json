{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "SAI_BUILD_TESTS": "ON",
        "SAI_SANITIZERS": ""
      }
    },
    {
      "name": "dev",
      "inherits": "base",
      "displayName": "Dev",
      "description": "Day-to-day development. Debug info, no optimization, no sanitizers.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "asan",
      "inherits": "base",
      "displayName": "Sanitizers",
      "description": "Debug build with AddressSanitizer and UndefinedBehaviorSanitizer.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SAI_SANITIZERS": "address;undefined"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release",
      "description": "Optimized build with debug info, for benchmarks and distribution checks.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "ci",
      "inherits": "dev",
      "displayName": "CI",
      "description": "Dev configuration with warnings promoted to errors.",
      "cacheVariables": {
        "CMAKE_COMPILE_WARNING_AS_ERROR": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "ci",
      "configurePreset": "ci"
    }
  ],
  "testPresets": [
    {
      "name": "common",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    },
    {
      "name": "dev",
      "inherits": "common",
      "configurePreset": "dev"
    },
    {
      "name": "asan",
      "inherits": "common",
      "configurePreset": "asan"
    },
    {
      "name": "release",
      "inherits": "common",
      "configurePreset": "release"
    },
    {
      "name": "ci",
      "inherits": "common",
      "configurePreset": "ci"
    }
  ],
  "workflowPresets": [
    {
      "name": "dev",
      "displayName": "Configure, build and test (dev)",
      "steps": [
        { "type": "configure", "name": "dev" },
        { "type": "build", "name": "dev" },
        { "type": "test", "name": "dev" }
      ]
    },
    {
      "name": "asan",
      "displayName": "Configure, build and test (sanitizers)",
      "steps": [
        { "type": "configure", "name": "asan" },
        { "type": "build", "name": "asan" },
        { "type": "test", "name": "asan" }
      ]
    },
    {
      "name": "ci",
      "displayName": "Configure, build and test (CI)",
      "steps": [
        { "type": "configure", "name": "ci" },
        { "type": "build", "name": "ci" },
        { "type": "test", "name": "ci" }
      ]
    }
  ]
}
